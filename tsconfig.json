{
  "compilerOptions": {
    "module": "esnext",
    "lib": ["es2021"],
    "target": "es2019",
    "moduleResolution": "bundler",
    "types": ["screeps", "lodash", "node"],
    "esModuleInterop": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "empire/*": ["./src/empire/*"],
      "utils/*": ["./src/utils/*"]
    },
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "noImplicitReturns": true,
    "allowUnreachableCode": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "allowUmdGlobalAccess": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "test/*"
  ]
}
