{
  "name": "kendalor-screeps-ai",
  "version": "3.0.0",
  "description": "Kendalor Screeps AI",
  "main": "index.js",
  "//": "If you add or change the names of destinations in screeps.json, make sure you update these scripts to reflect the changes",
  "scripts": {
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "bench": "node scripts/bench.mjs",
    "bench:slow": "node scripts/bench-slow.mjs",
    "bench:legacy": "node scripts/bench-legacy.mjs",
    "bundle-legacy": "rollup -c rollup.legacy.config.mjs",
    "watch:integration": "vitest run --config vitest.watch.config.ts",
    "sync-layouts": "tsx scripts/sync-layouts.ts",
    "watch:server": "node scripts/watch-server.mjs",
    "reset:server": "node scripts/reset-server.mjs",
    "expand:server": "node scripts/expand-map.mjs",
    "reseed:server": "node scripts/reseed-server.mjs",
    "extract:world-terrain": "node scripts/extract-world-terrain.mjs",
    "extract:world-objects": "node scripts/extract-world-objects.mjs",
    "bake:terrain-seed": "node scripts/bake-terrain-seed.mjs",
    "bake:objects-seed": "node scripts/bake-objects-seed.mjs",
    "make:empty-seed": "node scripts/make-empty-seed.mjs",
    "set-pserver-password": "node scripts/set-pserver-password.mjs",
    "prebuild": "npm test",
    "bundle": "rollup -c",
    "build": "rollup -c --verbose --environment LOCAL:true",
    "push-main": "rollup -c --environment DEST:main",
    "push-dev": "rollup -c --environment DEST:dev",
    "push-pserver": "rollup -c --environment DEST:pserver",
    "push-pserver:profile": "rollup -c --environment DEST:pserver,PROFILE:1",
    "push-sim": "rollup -c --environment DEST:sim",
    "watch-main": "rollup -cw --environment DEST:main",
    "watch-pserver": "rollup -cw --environment DEST:pserver",
    "watch-sim": "rollup -cw --environment DEST:sim",
    "postinstall": "patch-package"
  },
  "author": "",
  "license": "Unlicense",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^20.19.43",
    "@types/screeps": "^3.4.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "lodash": "^4.17.21",
    "node-gyp": "^10.3.1",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.5",
    "rollup": "^4.62.2",
    "rollup-plugin-clear": "^2.0.7",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-screeps": "^1.0.1",
    "screeps-server-mockup": "github:screepers/screeps-server-mockup#master",
    "tslib": "^2.8.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "source-map": "~0.6.1"
  },
  "allowScripts": {
    "@screeps/driver@5.3.0": true,
    "github:laverdet/isolated-vm#cb93efcc1881c826ee98ad34e66955c08713acb2": true,
    "bufferutil@4.1.0": true,
    "utf-8-validate@5.0.10": true,
    "screeps@4.3.0": true,
    "github:screepers/screeps-server-mockup#703645f408dbe770cbe8cb640c5ed8995f5e1c44": true
  }
}
